+/** Inputs that decide which agents the task tool offers. */
+export interface EffectiveAgentsInput {
+	agents: readonly AgentDefinition[];
+	sessionAgents: readonly AgentDefinition[];
+	disabledAgents: readonly string[];
+	parentSpawns: string;
+}
+
+/** Discovered plus session agents, minus `task.disabledAgents`, clamped by the parent spawn policy. */
+export function resolveEffectiveAgents(input: EffectiveAgentsInput): AgentDefinition[] {
+	const spawnPolicy = resolveSpawnPolicy(input.parentSpawns);
+	if (!spawnPolicy.enabled) return [];
+	const agents = [...input.agents, ...input.sessionAgents];
+	const disabled = new Set(input.disabledAgents);
+	const allowed = spawnPolicy.allowedAgents === null ? null : new Set(spawnPolicy.allowedAgents);
+	return agents.filter(agent => !disabled.has(agent.name) && (allowed === null || allowed.has(agent.name)));
+}
+
+/** The task tool's roster for `session`: same discovery memo and filters as the tool itself. */
