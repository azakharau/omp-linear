{
  "name": "omp-linear",
  "version": "1.1.0",
  "description": "Native Oh My Pi extension for Linear (private typed catalog, OAuth/API-key connections, native approvals)",
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "omp-extension",
    "linear",
    "graphql",
    "issue-tracker",
    "agent"
  ],
  "author": "Alaksiej Zacharau (https://github.com/azakharau)",
  "homepage": "https://github.com/azakharau/omp-linear#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azakharau/omp-linear.git"
  },
  "bugs": {
    "url": "https://github.com/azakharau/omp-linear/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0",
    "omp": ">=18.20.0"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "check": "bun run typecheck && bun run build:check && bun test test",
    "build": "bun build src/index.ts --target=bun --outdir dist --external '@oh-my-pi/pi-*' && bun run scripts/bundle-stamp.ts --write",
    "build:check": "bun run scripts/bundle-stamp.ts --check",
    "generate:catalog": "bun run scripts/generate-catalog.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "test:extension": "bun test test/extension.test.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:binary": "bun run scripts/smoke-binary.ts",
    "schema:check": "bun run scripts/check-schema-drift.ts"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0",
    "graphql": "17.1.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": ">=18.20.0",
    "@oh-my-pi/pi-ai": ">=18.20.0",
    "@oh-my-pi/pi-catalog": ">=18.20.0",
    "@oh-my-pi/pi-coding-agent": ">=18.20.0"
  },
  "devDependencies": {
    "@oh-my-pi/omptype": "18.20.1",
    "@oh-my-pi/pi-agent-core": "18.20.1",
    "@oh-my-pi/pi-ai": "18.20.1",
    "@oh-my-pi/pi-catalog": "18.20.1",
    "@oh-my-pi/pi-coding-agent": "18.20.1",
    "@types/bun": "1.4.4",
    "js-tiktoken": "1.0.21",
    "typescript": "7.0.2"
  }
}
